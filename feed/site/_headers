/releases/opkg/*
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=600, no-transform

/releases/apk/*
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=600, no-transform

/snapshots/opkg/*
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=600, no-transform

/snapshots/apk/*
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=600, no-transform

/manifest.json
  Cache-Control: public, max-age=600, must-revalidate

/assets/*
  Cache-Control: public, max-age=604800
