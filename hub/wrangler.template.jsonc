{
  "name": "themes-hub",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./site",
    "binding": "SITE",
    "run_worker_first": ["/api/*", "/assets/*", "/c/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "themes-hub",
      "database_id": "__HUB_D1_ID__"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "themes-hub-assets"
    }
  ],
  "routes": [{ "pattern": "__HUB_HOST__", "custom_domain": true }]
}
